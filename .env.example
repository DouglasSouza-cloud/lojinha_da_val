# Copie este arquivo para ".env" e preencha com os dados do SEU MySQL.
# NUNCA suba o arquivo ".env" (com as senhas reais) para o GitHub.

# Se estiver usando um MySQL LOCAL na sua máquina, use algo assim:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=sua_senha_aqui
# DB_NAME=loja_bela

# Se estiver usando o Aiven, pegue esses valores na aba "Overview" do seu
# serviço MySQL no painel do Aiven (Host, Port, User, Password, Database name):
DB_HOST=seu-servico.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=sua_senha_do_aiven
DB_NAME=defaultdb

# O Aiven exige conexão criptografada (SSL). Baixe o certificado "ca.pem"
# na aba "Overview" do serviço (botão "CA Certificate"), salve na pasta do
# projeto e aponte o caminho aqui:
DB_CA_CERT_PATH=./ca.pem

# Porta em que o site vai rodar na sua máquina
PORT=3000

# Senha simples para acessar o painel admin (troque por uma sua)
ADMIN_PASSWORD=troque-esta-senha
